{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "hyprland/language",
    "pulseaudio",
    "backlight",
    "battery",
    "tray"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "10": "Telegram"
    }
  },
  "clock": {
    "format": "{:%H:%M}",
    "interval": 60,
    "tooltip": true,
    "tooltip-format": "{:%d.%m.%Y}"
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "US",
    "format-ru": "RU"
  },
  "pulseaudio": {
    "format": "volume {volume}"
  },
  "backlight": {
    "format": "brightness {percent}"
  },
  "battery": {
    "format": "battery {capacity}%",
    "interval": 60
  },
  "tray": {
    "spacing": 10,
    "show-passive-items": true
  }
}
